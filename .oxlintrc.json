{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "caughtErrors": "none",
        "args": "none",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-console": "off",
    "no-control-regex": "off",
    "unicorn/no-useless-fallback-in-spread": "off"
  },
  "ignorePatterns": [
    "web/dist/**",
    "**/node_modules/**"
  ]
}
