{
  "name": "castpane",
  "version": "0.1.5-beta",
  "description": "See and control your own Mac from a phone or another computer, in a browser or as an installed PWA",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "setup": "npm ci && npm ci --prefix server",
    "dev": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "server": "node server/start.js",
    "diagram": "node tools/diagram.mjs",
    "shots": "node tools/shots.mjs",
    "lint": "oxlint server web/src tools"
  },
  "dependencies": {
    "framework7": "9.1.0",
    "framework7-icons": "5.0.5",
    "framework7-vue": "9.1.0",
    "jsqr": "1.4.0",
    "qrcode-generator": "2.0.4",
    "swiper": "12.2.0",
    "vue": "3.5.38"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.7",
    "oxlint": "1.87.0",
    "playwright": "1.63.0",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0"
  }
}
